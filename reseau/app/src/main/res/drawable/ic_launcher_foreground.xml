    <path
        android:pathData="M39.15,55.15 A21,21 0 0,1 68.85,55.15"
        android:strokeColor="#4A9FFF"
        android:strokeLineCap="round"
        android:strokeWidth="5" />
    <path
        android:pathData="M45.51,61.51 A12,12 0 0,1 62.49,61.51"
        android:strokeColor="#4A9FFF"
        android:strokeLineCap="round"
        android:strokeWidth="5" />
