    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Gauge track (outer arc, -60 to +60 degrees, radius 30 around the Wi-Fi dot) -->
    <path
        android:pathData="M28.02,55 A30,30 0 0,1 79.98,55"
        android:strokeColor="#0F3460"
        android:strokeLineCap="round"
        android:strokeWidth="5" />
    <!-- Gauge level (-60 to +20 degrees) -->
    <path
        android:pathData="M28.02,55 A30,30 0 0,1 64.26,41.81"
        android:strokeColor="#4A9FFF"
        android:strokeLineCap="round"
        android:strokeWidth="5" />
